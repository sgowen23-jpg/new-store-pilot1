# Copy this file to .env.local for local testing.
# In Vercel, add the same two values under Settings > Environment Variables.
# Use the same Supabase project as Team VB (Project Settings > API).
# Use the anon / publishable key here. Never the service role key.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
